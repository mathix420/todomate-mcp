# Firebase Authentication Web API key
TODOMATE_FIREBASE_API_KEY=

# Standard container timezone; controls the default date for MCP tools.
TZ=Europe/Paris

# Required only for `uv run todomate-mcp http`. Generate a long random value.
TODOMATE_MCP_ACCESS_TOKEN=

# Public HTTPS URL ending in /mcp when deployed behind a reverse proxy.
# TODOMATE_MCP_PUBLIC_URL=https://todos.example.com/mcp

# Optional file storage instead of OS Keyring. The Docker image defaults to this path.
# TODOMATE_CREDENTIALS_FILE=/data/credentials.json
